@* Rendered by PtyApp's "app" mode for the CLI tests of the app layer: focusable elements, a route and log entries. *@
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject NavigationManager Navigation
@inject ILogger<AppLayerView> Logger

<Rows>
    <Markup Content="App layer view" Decoration="@Decoration.Bold" />
    <Markup Content="@($"route: {Route}")" />
    <Markup Content="@($"clicked: {_clicks}")" />
    <div data-vnode-hook="save" data-focusable="true" data-focus-key="save" @key="@("save")"
         @onfocus="OnFocusSave" @onfocusout="OnBlurSave" @onclick="OnSave">
        <Markup Content="@(_focused == "save" ? "[Save]" : " Save ")" />
    </div>
    <div data-vnode-hook="cancel" data-focusable="true" data-focus-key="cancel" @key="@("cancel")"
         @onfocus="OnFocusCancel" @onfocusout="OnBlurCancel" @onclick="OnCancel">
        <Markup Content="@(_focused == "cancel" ? "[Cancel]" : " Cancel ")" />
    </div>
</Rows>

@code {
    private string? _focused;
    private int _clicks;

    private string Route => Navigation.ToBaseRelativePath(Navigation.Uri);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Logger.LogInformation("app ready");
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    private void OnFocusSave(FocusEventArgs e) => Focus("save");

    private void OnBlurSave(FocusEventArgs e) => Blur("save");

    private void OnFocusCancel(FocusEventArgs e) => Focus("cancel");

    private void OnBlurCancel(FocusEventArgs e) => Blur("cancel");

    private void Focus(string key)
    {
        _focused = key;
        StateHasChanged();
    }

    private void Blur(string key)
    {
        if (_focused == key)
        {
            _focused = null;
            StateHasChanged();
        }
    }

    private void OnSave(MouseEventArgs e)
    {
        _clicks++;
        Logger.LogInformation("saved {Count}", _clicks);
        StateHasChanged();
    }

    private void OnCancel(MouseEventArgs e)
    {
        Logger.LogWarning("cancelled");
        StateHasChanged();
    }
}
