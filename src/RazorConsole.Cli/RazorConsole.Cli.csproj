<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A tool needs no net9/net11 builds: the SDK runs the highest TFM the installed runtime supports. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>razorconsole</ToolCommandName>
    <RootNamespace>RazorConsole.Cli</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The SDK picks tools/net8.0 for a machine whose SDK runs on .NET 9 (or 8), which only has that runtime. -->
    <RollForward>Major</RollForward>
    <!-- The detached host launch on Windows calls CreateProcess with pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Besides the tool package, the release and nightly builds publish a native razorconsole binary per platform. -->
    <RazorConsolePublishNativeAot>true</RazorConsolePublishNativeAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RazorConsole.Core\RazorConsole.Core.csproj" />
    <ProjectReference Include="..\RazorConsole.Testing\RazorConsole.Testing.csproj" />
    <PackageReference Include="System.CommandLine" />
    <InternalsVisibleTo Include="RazorConsole.Tests" />
  </ItemGroup>
  <Import Project="$(RepoRoot)/nuget/nuget-package.props" />

  <!-- After the import: nuget-package.props turns the package on for every build. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <!-- Native AOT publish cannot run the package target at the same time. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Known trim warning from Microsoft.AspNetCore.Components, which RazorConsole.Core builds on. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <!-- Pack this package's own README instead of the repository README. -->
  <ItemGroup>
    <None Remove="$(RepoRoot)/README.md" />
    <None Include="README.md" Pack="true" PackagePath="." />
  </ItemGroup>

  <PropertyGroup>
    <!--
      The tool compares its own version with the running session host's (see HostConnector) and prints it for the
      version option.
      nuget-package.props sets only PackageVersion, so without this every build reports 1.0.0, nightlies included.
    -->
    <Version>$(PackageVersion)</Version>
    <Title>RazorConsole CLI</Title>
    <Description>Drive and inspect RazorConsole apps from the command line: run them in a pseudoterminal session, send input, wait for and assert on the screen, and read the component tree, focus, route, errors and logs of a Development or Debug app. Structured JSON results for CI and AI agents.</Description>
    <PackageTags>$(PackageTags);cli;testing;diagnostics</PackageTags>
  </PropertyGroup>

</Project>
