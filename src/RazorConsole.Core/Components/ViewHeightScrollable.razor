@namespace RazorConsole.Components
@using RazorConsole.Core.Utilities
@using RazorConsole.Core.Rendering
@using ScrollChangeSource = RazorConsole.Core.Layout.ScrollChangeSource
@using ScrollStateRegistry = RazorConsole.Core.Layout.ScrollStateRegistry
@using Spectre.Console

@attribute [Obsolete("Set Overflow=\"OverflowMode.Scroll\" on a Panel. IsScrollbarEmbedded becomes Scrollbar.Placement, and LinesToRender becomes Height.")]
@implements IDisposable
@inject ScrollStateRegistry ScrollState;

@* Not a Tab stop itself; the scrollbar takes focus. The wheel is handled by the layout engine. *@
<view-height-scrollable
    data-focusable="false"
    data-offset="@ScrollOffset"
    data-lines-to-render="@LinesToRender"
    data-enable-embedded="@IsScrollbarEmbedded.ToString()"
    data-scroll-id="@_scrollId">

    @if (Scrollbar != null)
    {
        <div data-scrollbar="true"
             data-focus-order="@FocusOrder"
             @onfocusin="OnFocusIn"
             @onfocusout="OnFocusOut"
             @onkeydown="HandleKeyDown"
             data-track-char="@Scrollbar.TrackChar"
             data-thumb-char="@Scrollbar.ThumbChar"
             data-track-color="@ScrollbarTrackColorAttribute"
             data-thumb-color="@ScrollbarThumbColorAttribute"
             data-min-thumb-height="@Scrollbar.MinThumbHeight"
             data-scrollbar-placement="@Scrollbar.Placement.ToString().ToLowerInvariant()"
             data-scrollbar-visibility="@Scrollbar.Visibility.ToString().ToLowerInvariant()">
        </div>
    }

    @ChildContent(new ScrollContext(HandleKeyDown, ScrollOffset))
</view-height-scrollable>

@code {
    private readonly string _scrollId = Guid.NewGuid().ToString("N");

    /// <summary>
    /// Number of lines visible at one time.
    /// </summary>
    /// <remarks>
    /// Default is 10. This determines how many items are shown before requiring scrolling.
    /// Set to 0 to use the arranged viewport height in the WidgetLayout pipeline.
    /// </remarks>
    /// <remarks>
    /// If using embedded mode with scrollbar, then counts only lines that are inside of container
    /// </remarks>
    [Parameter]
    public int LinesToRender { get; set; } = 10;

    /// <summary>
    /// Current scroll offset (index of the first visible line).
    /// </summary>
    [Parameter]
    public int ScrollOffset { get; set; }

    /// <summary>
    /// Event callback invoked when the scroll offset changes.
    /// </summary>
    [Parameter]
    public EventCallback<int> ScrollOffsetChanged { get; set; }

    /// <summary>
    /// Scrollbar settings. If provided, the scrollbar is enabled.
    /// </summary>
    [Parameter]
    public ScrollbarSettings? Scrollbar { get; set; }

    /// <summary>
    /// Flag that determines will scrollbar be embedded or not.
    /// </summary>
    /// <remarks>
    /// This feature is only active when there is exactly one direct child of type <see cref="Table"/> or <see cref="Panel"/>/<see cref="Border"/>.
    /// If multiple block-level elements are detected, the scrollbar will revert to the default side-rendering behavior.
    /// </remarks>
    /// <value>true</value>
    [Parameter]
    public bool IsScrollbarEmbedded { get; set; } = true;

    /// <summary>Tab order of the scrollbar, which takes focus; lower values first. Null keeps document order.</summary>
    [Parameter]
    public int? FocusOrder { get; set; }

    /// <summary>
    /// Raised for keys the scrollable does not handle itself (anything but arrows, paging, Home and End),
    /// so a page can keep its shortcuts while the scrollable has focus.
    /// </summary>
    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    [Parameter] public required RenderFragment<ScrollContext> ChildContent { get; set; }

    // The engine owns the scroll position: this component mirrors it into ScrollOffset, and pushes offsets it computes itself (keys) back.
    protected override void OnInitialized()
        => ScrollState.TopChanged += OnEngineTopChanged;

    protected override void OnParametersSet()
        => ScrollState.SetTop(_scrollId, ScrollOffset, ScrollChangeSource.Parameter);

    private void OnEngineTopChanged(string scrollId, int top)
    {
        if (scrollId != _scrollId || top == ScrollOffset)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            ScrollOffset = top;
            if (ScrollOffsetChanged.HasDelegate)
            {
                await ScrollOffsetChanged.InvokeAsync(top);
            }

            StateHasChanged();
        });
    }

    // Layout reports the real limit; until the first layout it is unknown.
    private int MaxOffset
    {
        get
        {
            var metrics = ScrollState.Get(_scrollId).Metrics;
            return metrics.ViewportHeight > 0 ? metrics.MaxTop : int.MaxValue;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        int maxOffset = MaxOffset;
        int newOffset = ScrollOffset;
        int page = Math.Max(1, LinesToRender);

        switch (e.Key)
        {
            case "ArrowDown":
            case "DownArrow": newOffset += 1; break;
            case "ArrowUp":
            case "UpArrow": newOffset = Math.Max(0, newOffset - 1); break;
            case "PageDown":
            case " ": newOffset += page; break;
            case "PageUp": newOffset = Math.Max(0, newOffset - page); break;
            case "Home": newOffset = 0; break;
            case "End": newOffset = maxOffset; break;
            default:
                await OnKeyDown.InvokeAsync(e);
                return;
        }

        newOffset = Math.Clamp(newOffset, 0, maxOffset);

        if (newOffset != ScrollOffset)
        {
            ScrollOffset = newOffset;
            ScrollState.SetTop(_scrollId, newOffset, ScrollChangeSource.Parameter);
            if (ScrollOffsetChanged.HasDelegate)
                await ScrollOffsetChanged.InvokeAsync(newOffset);
            StateHasChanged();
        }
    }

    private bool _isFocused;

    private string? ScrollbarTrackColorAttribute => Scrollbar is { } bar ? ColorAttribute.Format(_isFocused ? bar.TrackFocusedColor : bar.TrackColor) : null;

    private string? ScrollbarThumbColorAttribute => Scrollbar is { } bar ? ColorAttribute.Format(_isFocused ? bar.ThumbFocusedColor : bar.ThumbColor) : null;

    private void OnFocusIn(FocusEventArgs eventArgs)
    {
        _isFocused = true;
        Scrollbar?.OnFocusInCallback?.Invoke(eventArgs);
    }

    private void OnFocusOut(FocusEventArgs eventArgs)
    {
        _isFocused = false;
        Scrollbar?.OnFocusOutCallback?.Invoke(eventArgs);
    }

    public void Dispose()
    {
        ScrollState.TopChanged -= OnEngineTopChanged;
        ScrollState.Remove(_scrollId);
    }
}

@code{

    public sealed record ScrollContext(Func<KeyboardEventArgs, Task> KeyDownEventHandler, int CurrentOffset);

}
