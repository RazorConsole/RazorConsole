@namespace RazorConsole.Components

@using System.Collections.Generic
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.DependencyInjection
@using OverflowMode = RazorConsole.Core.Layout.OverflowMode
@using ScrollbarSettings = RazorConsole.Core.Rendering.ScrollbarSettings
@using RazorConsole.Core.Utilities
@using ScrollChangeSource = RazorConsole.Core.Layout.ScrollChangeSource
@using ScrollStateRegistry = RazorConsole.Core.Layout.ScrollStateRegistry
@using RazorConsole.Core.Rendering.ComponentMarkup
@using Spectre.Console
@implements IDisposable
@inject IServiceProvider Services

<div class="@Class"
    @attributes="AdditionalAttributes"
    data-layout="box"
    data-padding="@PaddingAttribute"
    data-margin="@MarginAttribute"
    data-expand="@ExpandAttribute"
    data-fill-width="@FillWidthAttribute"
    data-fill-height="@FillHeightAttribute"
    data-width="@WidthAttribute"
    data-height="@HeightAttribute"
    data-header="@TitleAttribute"
    data-header-color="@HeaderColorAttribute"
    data-border-color="@BorderColorAttribute"
    data-border="@BorderAttribute"
    data-horizontal="@HorizontalAttribute"
    data-vertical="@VerticalAttribute"
    data-overflow="@OverflowAttribute"
    data-scroll-id="@ScrollIdAttribute"
    data-scroll-top="@ScrollTopAttribute"
    data-scrollbar-placement="@ScrollbarPlacementAttribute"
    data-scrollbar-visibility="@ScrollbarVisibilityAttribute"
    data-scrollbar-track-char="@ScrollbarTrackCharAttribute"
    data-scrollbar-thumb-char="@ScrollbarThumbCharAttribute"
    data-scrollbar-track-color="@ScrollbarTrackColorAttribute"
    data-scrollbar-thumb-color="@ScrollbarThumbColorAttribute"
    data-scrollbar-min-thumb-height="@ScrollbarMinThumbHeightAttribute">
    @ChildContent
</div>

@code {
    private static readonly Padding NoPadding = new(0, 0, 0, 0);

    private static readonly IReadOnlyDictionary<BoxBorder, string> BorderNames = new Dictionary<BoxBorder, string>
    {
        { BoxBorder.Square, "square" },
        { BoxBorder.Rounded, "rounded" },
        { BoxBorder.Double, "double" },
        { BoxBorder.Heavy, "heavy" },
        { BoxBorder.Ascii, "ascii" },
        { BoxBorder.None, "none" },
    };

    /// <summary>
    /// Content rendered inside the box.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// CSS class emitted for translator compatibility. Default is <c>box</c>.
    /// </summary>
    [Parameter]
    public string Class { get; set; } = "box";

    /// <summary>
    /// Padding around the child content.
    /// </summary>
    [Parameter]
    public Padding? Padding { get; set; }

    /// <summary>
    /// Margin outside the box border.
    /// </summary>
    [Parameter]
    public Padding? Margin { get; set; }

    /// <summary>
    /// Whether the box should expand when a parent container allocates remaining space. Prefer <see cref="FillWidth"/> and <see cref="FillHeight"/> for new code.
    /// </summary>
    [Parameter]
    public bool Expand { get; set; }

    /// <summary>
    /// Whether the box should fill the width offered by its parent.
    /// </summary>
    [Parameter]
    public bool FillWidth { get; set; }

    /// <summary>
    /// Whether the box should fill the height offered by its parent.
    /// </summary>
    [Parameter]
    public bool FillHeight { get; set; }

    /// <summary>
    /// Explicit width in terminal cells.
    /// </summary>
    [Parameter]
    public int? Width { get; set; }

    /// <summary>
    /// Explicit height in terminal rows.
    /// </summary>
    [Parameter]
    public int? Height { get; set; }

    /// <summary>
    /// Optional title used by panel-compatible boxes.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Optional title color used by panel-compatible boxes.
    /// </summary>
    [Parameter]
    public Color? TitleColor { get; set; }

    /// <summary>
    /// Optional border color used by panel-compatible boxes.
    /// </summary>
    [Parameter]
    public Color? BorderColor { get; set; }

    /// <summary>
    /// Optional border style used by panel-compatible boxes.
    /// </summary>
    [Parameter]
    public BoxBorder? Border { get; set; }

    /// <summary>
    /// Horizontal child alignment used by align-compatible boxes.
    /// </summary>
    [Parameter]
    public HorizontalAlignment? Horizontal { get; set; }

    /// <summary>
    /// Vertical child alignment used by align-compatible boxes.
    /// </summary>
    [Parameter]
    public VerticalAlignment? Vertical { get; set; }

    /// <summary>
    /// What happens to content taller than the box, like CSS <c>overflow</c>. With <see cref="OverflowMode.Scroll"/> the content scrolls
    /// inside the box while the border and title stay fixed; give the box a bounded height (for example <see cref="FillHeight"/>
    /// inside a bounded parent, or <see cref="Height"/>). Default is <see cref="OverflowMode.Visible"/>.
    /// </summary>
    [Parameter]
    public OverflowMode Overflow { get; set; }

    /// <summary>
    /// Scroll offset in rows. The engine owns the scroll position, so this is applied only when its value changes
    /// (semi-controlled): a constant value never resets scrolling the user did. Use <c>@bind-ScrollTop</c> to follow the position.
    /// </summary>
    [Parameter]
    public int ScrollTop { get; set; }

    /// <summary>
    /// Raised when the engine changes the scroll offset (wheel, scrollbar, clamping after the content shrinks).
    /// </summary>
    [Parameter]
    public EventCallback<int> ScrollTopChanged { get; set; }

    /// <summary>
    /// Stable identity of the scroll state. Without it the state lives and dies with this component instance.
    /// </summary>
    [Parameter]
    public string? ScrollId { get; set; }

    /// <summary>
    /// How the scrollbar of a scrolling box looks and where it is drawn. Default is a one-column scrollbar inside the container that shows while the content overflows.
    /// </summary>
    [Parameter]
    public ScrollbarSettings? Scrollbar { get; set; }

    /// <summary>
    /// Additional attributes applied to the emitted box element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object?>? AdditionalAttributes { get; set; }

    private readonly string _instanceScrollId = Guid.NewGuid().ToString("N");
    private ScrollStateRegistry? _registry;
    private string? _subscribedScrollId;
    private int _lastScrollTopParameter;

    private string EffectiveScrollId => string.IsNullOrWhiteSpace(ScrollId) ? _instanceScrollId : ScrollId;

    private ScrollbarSettings? ActiveScrollbar => Overflow == OverflowMode.Scroll ? Scrollbar : null;

    private string? ScrollbarPlacementAttribute => ActiveScrollbar?.Placement.ToString().ToLowerInvariant();

    private string? ScrollbarVisibilityAttribute => ActiveScrollbar?.Visibility.ToString().ToLowerInvariant();

    private string? ScrollbarTrackCharAttribute => ActiveScrollbar?.TrackChar.ToString();

    private string? ScrollbarThumbCharAttribute => ActiveScrollbar?.ThumbChar.ToString();

    private string? ScrollbarTrackColorAttribute => ActiveScrollbar is { } bar ? ColorAttribute.Format(bar.TrackColor) : null;

    private string? ScrollbarThumbColorAttribute => ActiveScrollbar is { } bar ? ColorAttribute.Format(bar.ThumbColor) : null;

    private string? ScrollbarMinThumbHeightAttribute => ActiveScrollbar?.MinThumbHeight.ToString(CultureInfo.InvariantCulture);

    private string? OverflowAttribute => Overflow == OverflowMode.Visible ? null : Overflow.ToString().ToLowerInvariant();

    private string? ScrollIdAttribute => Overflow == OverflowMode.Scroll ? EffectiveScrollId : null;

    private string? ScrollTopAttribute => Overflow == OverflowMode.Scroll && ScrollTop > 0
        ? ScrollTop.ToString(CultureInfo.InvariantCulture)
        : null;

    protected override void OnParametersSet()
    {
        if (Overflow != OverflowMode.Scroll)
        {
            Unsubscribe();
            return;
        }

        var id = EffectiveScrollId;
        if (_subscribedScrollId != id)
        {
            Unsubscribe();
            _registry = Services.GetService<ScrollStateRegistry>();
            if (_registry is not null)
            {
                _registry.TopChanged += OnEngineTopChanged;
                _subscribedScrollId = id;
            }
        }

        if (ScrollTop != _lastScrollTopParameter)
        {
            _lastScrollTopParameter = ScrollTop;
            _registry?.SetTop(id, ScrollTop, ScrollChangeSource.Parameter);
        }
    }

    private void OnEngineTopChanged(string scrollId, int top)
    {
        if (scrollId == _subscribedScrollId && ScrollTopChanged.HasDelegate)
        {
            _ = InvokeAsync(() => ScrollTopChanged.InvokeAsync(top));
        }
    }

    private void Unsubscribe()
    {
        if (_registry is null)
        {
            return;
        }

        _registry.TopChanged -= OnEngineTopChanged;
        if (_subscribedScrollId is not null)
        {
            _registry.Remove(_subscribedScrollId);
        }

        _registry = null;
        _subscribedScrollId = null;
    }

    public void Dispose() => Unsubscribe();

    private string ExpandAttribute => Expand ? "true" : "false";

    private string FillWidthAttribute => FillWidth ? "true" : "false";

    private string FillHeightAttribute => FillHeight ? "true" : "false";

    private string? TitleAttribute => string.IsNullOrWhiteSpace(Title) ? null : Title;

    private string? HeaderColorAttribute => TitleColor?.ToMarkup();

    private string? BorderColorAttribute => BorderColor?.ToMarkup();

    private string? BorderAttribute
    {
        get
        {
            if (Border is null)
            {
                return null;
            }

            if (BorderNames.TryGetValue(Border, out var name))
            {
                return name;
            }

            return Border.GetType().Name.ToLowerInvariant();
        }
    }

    private string? HorizontalAttribute => Horizontal?.ToString().ToLowerInvariant();

    private string? VerticalAttribute => Vertical?.ToString().ToLowerInvariant();

    private string? PaddingAttribute
        => FormatSpacing(Padding ?? NoPadding);

    private string? MarginAttribute
        => FormatSpacing(Margin ?? NoPadding);

    private static string? FormatSpacing(Padding spacing)
    {
        if (spacing.Left == 0 && spacing.Top == 0 && spacing.Right == 0 && spacing.Bottom == 0)
        {
            return null;
        }

        return string.Join(",",
            spacing.Left.ToString(CultureInfo.InvariantCulture),
            spacing.Top.ToString(CultureInfo.InvariantCulture),
            spacing.Right.ToString(CultureInfo.InvariantCulture),
            spacing.Bottom.ToString(CultureInfo.InvariantCulture));
    }

    private string? WidthAttribute => Width.HasValue && Width.Value > 0
        ? Width.Value.ToString(CultureInfo.InvariantCulture)
        : null;

    private string? HeightAttribute => Height.HasValue && Height.Value > 0
        ? Height.Value.ToString(CultureInfo.InvariantCulture)
        : null;
}