@namespace RazorConsole.Components

@using Microsoft.AspNetCore.Components
@using OverflowMode = RazorConsole.Core.Layout.OverflowMode
@using ScrollController = RazorConsole.Core.Layout.ScrollController
@using OverscrollBehavior = RazorConsole.Core.Layout.OverscrollBehavior
@using ScrollbarSettings = RazorConsole.Core.Rendering.ScrollbarSettings
@using Spectre.Console

<Box Class="panel"
    Title="@Title"
    TitleColor="@TitleColor"
    BorderColor="@BorderColor"
    Border="@Border"
    Padding="@Padding"
    Margin="@Margin"
    Width="@Width"
    Height="@Height"
    Expand="@Expand"
    FillWidth="@FillWidth"
    FillHeight="@FillHeight"
    Overflow="@Overflow"
    OverscrollBehavior="@OverscrollBehavior"
    Focusable="@Focusable"
    Controller="@Controller"
    StickToBottom="@StickToBottom"
    ScrollTop="@ScrollTop"
    ScrollTopChanged="@ScrollTopChanged"
    ScrollId="@ScrollId"
    Scrollbar="@Scrollbar">
    @ChildContent
</Box>

@code {
    /// <summary>
    /// Renders a panel with optional title, border, and padding using Spectre.Console's <see cref="global::Spectre.Console.Panel"/> renderable.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Wraps content in a customizable box with borders, titles, and padding for creating visual sections.
    /// For simple borders without titles, use the <see cref="Border"/> component instead.
    /// </para>
    /// <para>
    /// See the <see href="https://spectreconsole.net/widgets/panel">Spectre.Console Panel documentation</see> for more information.
    /// </para>
    /// </remarks>

    /// <summary>
    /// Content to render inside the panel.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    /// <summary>
    /// Title text displayed at the top of the panel border. If <c>null</c> or empty, no title is shown.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Color of the panel title. If <c>null</c>, uses default console color.
    /// </summary>
    [Parameter]
    public Color? TitleColor { get; set; }

    /// <summary>
    /// Color of the panel border. If <c>null</c>, uses default console color.
    /// </summary>
    [Parameter]
    public Color? BorderColor { get; set; }

    /// <summary>
    /// Style of the panel border. See <see cref="BoxBorder"/> for available styles like <see cref="BoxBorder.Rounded"/>, <see cref="BoxBorder.Square"/>, and <see cref="BoxBorder.Double"/>.
    /// </summary>
    [Parameter]
    public BoxBorder? Border { get; set; }

    /// <summary>
    /// Height of the panel in lines. If <c>null</c> or less than 1, height is automatically determined by content.
    /// </summary>
    [Parameter]
    public int? Height { get; set; }

    /// <summary>
    /// Padding inside the panel border as (left, top, right, bottom). If <c>null</c>, no padding is applied.
    /// </summary>
    [Parameter]
    public Padding? Padding { get; set; }

    /// <summary>
    /// Margin outside the panel border as (left, top, right, bottom). If <c>null</c>, no margin is applied.
    /// </summary>
    [Parameter]
    public Padding? Margin { get; set; }

    /// <summary>
    /// Width of the panel in characters. If <c>null</c> or less than 1, width is automatically determined by content.
    /// </summary>
    [Parameter]
    public int? Width { get; set; }

    /// <summary>
    /// Whether the panel should expand to fill available space. Default is <c>false</c>.
    /// </summary>
    [Parameter]
    public bool Expand { get; set; }

    /// <summary>
    /// Whether the panel should fill the width offered by its parent.
    /// </summary>
    [Parameter]
    public bool FillWidth { get; set; }

    /// <summary>
    /// Whether the panel should fill the height offered by its parent.
    /// </summary>
    [Parameter]
    public bool FillHeight { get; set; }

    /// <summary>
    /// What happens to content taller than the panel. See <see cref="Box.Overflow"/>.
    /// </summary>
    [Parameter]
    public OverflowMode Overflow { get; set; }

    /// <summary>
    /// Whether scrolling continues in the parent scroll container once this one reaches its limit. See <see cref="Box.OverscrollBehavior"/>.
    /// </summary>
    [Parameter]
    public OverscrollBehavior OverscrollBehavior { get; set; }

    /// <summary>
    /// Makes the scroll container a Tab stop that scrolls with the arrow keys, PageUp, PageDown, Home and End. See <see cref="Box.Focusable"/>.
    /// </summary>
    [Parameter]
    public bool Focusable { get; set; }

    /// <summary>
    /// Scrolls this container from code. See <see cref="Box.Controller"/>.
    /// </summary>
    [Parameter]
    public ScrollController? Controller { get; set; }

    /// <summary>
    /// Keeps the end of the content in view while it grows. See <see cref="Box.StickToBottom"/>.
    /// </summary>
    [Parameter]
    public bool StickToBottom { get; set; }

    /// <summary>
    /// Scroll offset in rows, applied when its value changes. See <see cref="Box.ScrollTop"/>.
    /// </summary>
    [Parameter]
    public int ScrollTop { get; set; }

    /// <summary>
    /// Raised when the engine changes the scroll offset.
    /// </summary>
    [Parameter]
    public EventCallback<int> ScrollTopChanged { get; set; }

    /// <summary>
    /// Stable identity of the scroll state. See <see cref="Box.ScrollId"/>.
    /// </summary>
    [Parameter]
    public string? ScrollId { get; set; }

    /// <summary>
    /// How the scrollbar looks and where it is drawn. See <see cref="Box.Scrollbar"/>.
    /// </summary>
    [Parameter]
    public ScrollbarSettings? Scrollbar { get; set; }
}
