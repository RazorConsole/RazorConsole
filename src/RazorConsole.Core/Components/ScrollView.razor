@namespace RazorConsole.Components

@using OverflowMode = RazorConsole.Core.Layout.OverflowMode
@using OverscrollBehavior = RazorConsole.Core.Layout.OverscrollBehavior
@using ScrollbarSettings = RazorConsole.Core.Rendering.ScrollbarSettings
@using ScrollController = RazorConsole.Core.Layout.ScrollController

<Box Class="scroll-view"
    Overflow="OverflowMode.Scroll"
    Width="@Width"
    Height="@Height"
    FillWidth="@FillWidth"
    FillHeight="@(Height is null)"
    Scrollbar="@Scrollbar"
    OverscrollBehavior="@OverscrollBehavior"
    Focusable="@Focusable"
    Controller="@Controller"
    StickToBottom="@StickToBottom"
    ScrollId="@ScrollId"
    ScrollTop="@ScrollTop"
    ScrollTopChanged="@ScrollTopChanged">
    @ChildContent
</Box>

@code {
    /// <summary>
    /// The content that scrolls.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Fixed height in rows. When not set, the view fills the height it is given, so put it in a parent with a bounded height.
    /// </summary>
    [Parameter]
    public int? Height { get; set; }

    /// <summary>
    /// Fixed width in columns.
    /// </summary>
    [Parameter]
    public int? Width { get; set; }

    /// <summary>
    /// Fills the width it is given.
    /// </summary>
    [Parameter]
    public bool FillWidth { get; set; } = true;

    /// <summary>
    /// How the scrollbar looks and where it is drawn. The scrollbar is on the right edge by default; set <c>Visibility</c> to
    /// <c>Never</c> to hide it.
    /// </summary>
    [Parameter]
    public ScrollbarSettings? Scrollbar { get; set; }

    /// <summary>
    /// Whether scrolling continues in the parent scroll container at the limit. See <see cref="Box.OverscrollBehavior"/>.
    /// </summary>
    [Parameter]
    public OverscrollBehavior OverscrollBehavior { get; set; }

    /// <summary>
    /// Makes the view a Tab stop that scrolls with the keyboard. See <see cref="Box.Focusable"/>.
    /// </summary>
    [Parameter]
    public bool Focusable { get; set; }

    /// <summary>
    /// Scrolls the view from code and reports its position.
    /// </summary>
    [Parameter]
    public ScrollController? Controller { get; set; }

    /// <summary>
    /// Keeps the end of the content in view while it grows, like a log or a chat.
    /// </summary>
    [Parameter]
    public bool StickToBottom { get; set; }

    /// <summary>
    /// Stable identity of the scroll state. See <see cref="Box.ScrollId"/>.
    /// </summary>
    [Parameter]
    public string? ScrollId { get; set; }

    /// <summary>
    /// Scroll offset in rows, applied when its value changes. See <see cref="Box.ScrollTop"/>.
    /// </summary>
    [Parameter]
    public int ScrollTop { get; set; }

    /// <summary>
    /// Raised when the engine changes the scroll offset.
    /// </summary>
    [Parameter]
    public EventCallback<int> ScrollTopChanged { get; set; }
}
