@inherits LayoutComponentBase

<Rows Expand="true">
    <Header/>
    <Panel Expand="true">
        <Columns Expand="true">
            <Padder Padding="@(new (1, 1, 1, 1))">
                <NavBar @bind-IsFocused="NavBarIsFocused" />
            </Padder>
            <Padder Padding="@(new(0,1,0,0))" Expand="true">
                <ViewHeightScrollable LinesToRender="0" Scrollbar="new()" IsScrollbarEmbedded="false">
                    @Body
                </ViewHeightScrollable>
            </Padder>
        </Columns>
    </Panel>
    <Footer NavBarIsFocused="NavBarIsFocused" />
</Rows>

@code {
    private bool NavBarIsFocused;
}
