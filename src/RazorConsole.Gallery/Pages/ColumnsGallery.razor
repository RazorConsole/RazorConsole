@page "/columns"

<GalleryWorkbench Id="columns" Title="Columns" Description="Columns lays out child content horizontally, optionally stretching items to fill the available width." Code="@CurrentCode" OnReset="() => _expand = true" Source="Columns">
    <Preview>
        <Columns Expand="@_expand">
            <Rows>
                <Markup Content="Column 1" Decoration="@Decoration.Bold" />
            </Rows>
            <Rows>
                <Markup Content="Column 2" Decoration="@Decoration.Bold" />
            </Rows>
            <Rows>
                <Markup Content="Column 3" Decoration="@Decoration.Bold" />
            </Rows>
        </Columns>
    </Preview>
    <Properties>
        <Flex Direction="FlexDirection.Row" Gap="1">
            <GalleryButton Id="columns-expand" Text="@($"Expand {(_expand ? "on" : "off")}")" Selected="@_expand" OnClick="() => _expand = !_expand" />
        </Flex>
    </Properties>
</GalleryWorkbench>

@code {
    private bool _expand = true;
    private string CurrentCode => _exampleCode.Replace("Expand=\"true\"", $"Expand=\"{_expand.ToString().ToLowerInvariant()}\"");
    private static readonly string _exampleCode = @"<Columns Expand=""true"">
    <Rows>
        <Markup Content=""Column 1"" Decoration=""Decoration.Bold"" />
    </Rows>
    <Rows>
        <Markup Content=""Column 2"" Decoration=""Decoration.Bold"" />
    </Rows>
    <Rows>
        <Markup Content=""Column 3"" Decoration=""Decoration.Bold"" />
    </Rows>
</Columns>".Trim();
}
