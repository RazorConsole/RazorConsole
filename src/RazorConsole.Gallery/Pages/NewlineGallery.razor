@page "/newline"

<GalleryWorkbench Id="newline" Title="Newline" Description="Newline injects a line break into the render tree, letting you add intentional spacing between elements." Code="@_exampleCode" Source="Newline">
    <Preview>
        <Rows>
            <Markup Content="• Brew coffee" />
            <Newline />
            <Markup Content="• Review pull requests" />
            <Newline />
            <Newline />
            <Markup Content="Break before stand-up"
                    Foreground="@Color.Grey70"
                    Decoration="@Decoration.Italic" />
        </Rows>
    </Preview>
</GalleryWorkbench>

@code {
    private static readonly string _exampleCode = @"
<Rows>
    <Markup Content=""• Brew coffee"" />
    <Newline />
    <Markup Content=""• Review pull requests"" />
    <Newline />
    <Newline />
    <Markup Content=""Break before stand-up""
           Foreground=""Color.Grey70""
           Decoration=""Decoration.Italic"" />
</Rows>".Trim();
}
