@page "/rows"

<GalleryWorkbench Id="rows" Title="Rows" Description="Rows stacks child content vertically and can optionally expand height to fill the available space." Code="@CurrentCode" OnReset="() => _reverse = false" Source="Rows">
    <Preview>
        <Rows>
            @foreach (var line in _reverse ? Enumerable.Reverse(_lines) : _lines)
            {
                <Markup Content="@line" />
            }
        </Rows>
    </Preview>
    <Properties>
        <Flex Direction="FlexDirection.Row" Gap="1">
            <GalleryButton Id="rows-reverse" Text="Reverse order" Selected="@_reverse" OnClick="() => _reverse = !_reverse" />
        </Flex>
    </Properties>
</GalleryWorkbench>

@code {
    private bool _reverse;
    private static readonly string[] _lines = ["Morning: Daily sync", "Afternoon: Pair with teammates", "Evening: Ship features"];
    private string CurrentCode => "<Rows>\n" + string.Join("\n", (_reverse ? Enumerable.Reverse(_lines) : _lines).Select(line => $"    <Markup Content=\"{line}\" />")) + "\n</Rows>";
    private static readonly string _exampleCode = @"
<Rows>
    <Markup Content=""Morning: Daily sync"" />
    <Markup Content=""Afternoon: Pair with teammates"" />
    <Markup Content=""Evening: Ship features""
           Foreground=""Color.Chartreuse1"" />
</Rows>".Trim();}
