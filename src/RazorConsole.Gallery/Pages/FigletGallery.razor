@page "/figlet"

<GalleryWorkbench Id="figlet" Title="Figlet" Description="Figlet renders large ASCII art text using Figlet fonts. " Code="@_exampleCode" Source="Figlet">
    <Preview>
        <Panel Title="Figlet" Border="BoxBorder.Rounded" Expand="true">
        <Figlet Content="Default color"/>
        <Figlet Content="Color.Aqua" Color="Color.Aqua"/>
        <Figlet Content="Justify.Left" Justify="Justify.Left"/>
        <Figlet Font="@_customFontPath" Color="Color.Orange1" Content="Custom"/>
        </Panel>
    </Preview>
</GalleryWorkbench>

@code {

    private static readonly string _customFontPath = Path.Combine(
        AppContext.BaseDirectory,
        "Fonts",
        "Slant Relief.flf");

    private static readonly string _exampleCode = @"
<Panel Title=""Figlet"" Border=""BoxBorder.Rounded"" Expand=""true"">
    <Figlet Content=""Default color""/>
    <Figlet Content=""Color.Aqua"" Color=""Color.Aqua""/>
    <Figlet Content=""Justify.Left"" Justify=""Justify.Left""/>
    <Figlet Font=""Fonts/Slant Relief.flf"" Color=""Color.Orange1"" Content=""Custom""/>
</Panel>".Trim();}
