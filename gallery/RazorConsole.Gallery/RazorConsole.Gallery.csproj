<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>razorconsole-gallery</ToolCommandName>
    <RazorConsolePublishNativeAot>true</RazorConsolePublishNativeAot>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Import Project="$(RepoRoot)/nuget/nuget-package.props"/>

  <PropertyGroup>
    <Title>Component Gallery</Title>
    <Description>Explore RazorConsole components in an interactive terminal gallery.</Description>
    <PackageProjectUrl>https://razorconsole.com/docs/component-gallery/</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <!-- Native AOT publish cannot run the package target at the same time. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Known trim warning from Microsoft.AspNetCore.Components; Gallery routes are rooted below. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RazorConsole.Core\RazorConsole.Core.csproj"/>
    <PackageReference Include="Microsoft.Extensions.Hosting"/>
    <PackageReference Include="Microsoft.Extensions.Http"/>
    <PackageReference Include="NuGet.Versioning"/>
    <PackageReference Include="Spectre.Console"/>
  </ItemGroup>

  <!-- For Native AOT trimming (Needed because of routing) -->
  <ItemGroup Condition="'$(OutputType)' == 'Exe' AND '$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="$(AssemblyName)"/>
  </ItemGroup>

</Project>
