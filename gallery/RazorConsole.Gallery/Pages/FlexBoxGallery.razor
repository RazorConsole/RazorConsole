@page "/flexbox"

<GalleryWorkbench Id="flexbox" Title="FlexBox" Description="Explore direction, spacing, alignment and wrapping." Code="@CurrentCode" OnReset="() => _selected = 0">
    <Options>
        <Flex Direction="FlexDirection.Column">
            @for (var i = 0; i < _names.Length; i++)
            {
                var index = i;
                <GalleryButton Id="@($"flexbox-sample-{index}")" Text="@_names[index]" Selected="@(_selected == index)" OnClick="() => _selected = index" />
            }
        </Flex>
    </Options>
    <Preview>
        @switch (_selected)
        {
            case 0:
                <FlexBox Direction="FlexDirection.Row" Gap="5">
                    <Markup Content="Home" Foreground="Color.Green" />
                    <Markup Content="About" Foreground="Color.Blue" />
                    <Markup Content="Contact" Foreground="Color.Yellow" />
                </FlexBox>
                break;
            case 1:
                <FlexBox Direction="FlexDirection.Row" Justify="FlexJustify.Center" Gap="2">
                    <Markup Content="Open" Decoration="Decoration.Bold" />
                    <Markup Content="Save" Decoration="Decoration.Bold" />
                    <Markup Content="Close" Decoration="Decoration.Bold" />
                </FlexBox>
                break;
            case 2:
                <FlexBox Direction="FlexDirection.Row" Justify="FlexJustify.SpaceBetween">
                    <Markup Content="◀ Prev" Foreground="Color.Green" />
                    <Markup Content="Page 3 of 10" Foreground="Color.Yellow" />
                    <Markup Content="Next ▶" Foreground="Color.Green" />
                </FlexBox>
                break;
            case 3:
                <FlexBox Direction="FlexDirection.Column" Gap="1" Align="FlexAlign.Center">
                    <Markup Content="Status Dashboard" Decoration="@(Decoration.Bold | Decoration.Underline)" />
                    <Markup Content="✔ Build passed" Foreground="Color.Green" />
                    <Markup Content="✔ Tests passed" Foreground="Color.Green" />
                    <Markup Content="⚠ 2 warnings" Foreground="Color.Yellow" />
                </FlexBox>
                break;
            case 4:
                <FlexBox Direction="FlexDirection.Row" Wrap="FlexWrap.Wrap" Gap="2">
                    <Markup Content="csharp" Foreground="Color.Blue" />
                    <Markup Content="razor" Foreground="Color.Green" />
                    <Markup Content="html" Foreground="Color.Yellow" />
                    <Markup Content="css" Foreground="Color.Red" />
                    <Markup Content="json" Foreground="Color.Magenta1" />
                    <Markup Content="xml" Foreground="Color.Cyan1" />
                    <Markup Content="sql" Foreground="Color.Grey" />
                    <Markup Content="python" Foreground="Color.Blue" />
                    <Markup Content="javascript" Foreground="Color.Green" />
                    <Markup Content="typescript" Foreground="Color.Yellow" />
                </FlexBox>
                break;
        }
    </Preview>
</GalleryWorkbench>

@code {
    private int _selected;
    private static readonly string[] _names = ["Row with Gap", "Row + Justify Center", "Row + SpaceBetween", "Column Direction", "Wrapping"];
    private string CurrentCode => _selected switch { 0 => _rowGapCode, 1 => _justifyCenterCode, 2 => _spaceBetweenCode, 3 => _columnCode, 4 => _wrapCode, _ => _rowGapCode };

    private static readonly string _rowGapCode = @"<FlexBox Direction=""FlexDirection.Row"" Gap=""5"">
    <Markup Content=""Home"" Foreground=""Color.Green"" />
    <Markup Content=""About"" Foreground=""Color.Blue"" />
    <Markup Content=""Contact"" Foreground=""Color.Yellow"" />
</FlexBox>".Trim();

    private static readonly string _justifyCenterCode = @"<FlexBox Direction=""FlexDirection.Row""
        Justify=""FlexJustify.Center"" Gap=""2"">
    <Markup Content=""Open"" Decoration=""Decoration.Bold"" />
    <Markup Content=""Save"" Decoration=""Decoration.Bold"" />
    <Markup Content=""Close"" Decoration=""Decoration.Bold"" />
</FlexBox>".Trim();

    private static readonly string _spaceBetweenCode = @"<FlexBox Direction=""FlexDirection.Row""
        Justify=""FlexJustify.SpaceBetween"">
    <Markup Content=""◀ Prev"" Foreground=""Color.Green"" />
    <Markup Content=""Page 3 of 10"" Foreground=""Color.Yellow"" />
    <Markup Content=""Next ▶"" Foreground=""Color.Green"" />
</FlexBox>".Trim();

    private static readonly string _columnCode = @"<FlexBox Direction=""FlexDirection.Column""
        Gap=""1"" Align=""FlexAlign.Center"">
    <Markup Content=""Status Dashboard""
           Decoration=""@(Decoration.Bold | Decoration.Underline)"" />
    <Markup Content=""✔ Build passed"" Foreground=""Color.Green"" />
    <Markup Content=""✔ Tests passed"" Foreground=""Color.Green"" />
    <Markup Content=""⚠ 2 warnings"" Foreground=""Color.Yellow"" />
</FlexBox>".Trim();

    private static readonly string _wrapCode = @"<FlexBox Direction=""FlexDirection.Row""
        Wrap=""FlexWrap.Wrap"" Gap=""2"">
    <Markup Content=""csharp"" Foreground=""Color.Blue"" />
    <Markup Content=""razor"" Foreground=""Color.Green"" />
    <Markup Content=""html"" Foreground=""Color.Yellow"" />
    <Markup Content=""css"" Foreground=""Color.Red"" />
    ...
</FlexBox>".Trim();

    private const string DocumentationUrl =
        "https://github.com/LittleLittleCloud/RazorConsole/blob/main/src/RazorConsole.Core/Components/FlexBox.razor";
}
