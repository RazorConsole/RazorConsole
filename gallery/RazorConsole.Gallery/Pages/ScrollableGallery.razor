@page "/scrollable"
@using OverflowMode = RazorConsole.Core.Layout.OverflowMode
@using ScrollController = RazorConsole.Core.Layout.ScrollController
@using ScrollbarSettings = RazorConsole.Core.Rendering.ScrollbarSettings
@using ScrollbarPlacement = RazorConsole.Core.Rendering.ScrollbarPlacement

<GalleryWorkbench Id="scrollable" Title="Scrollable" Description="Scrolling is a property of a container: set Overflow, or use ScrollView. Wheel over a preview, or focus it and use the keys." Code="@_scrollableMarkup" Source="Scrollable" OnReset="() => { _resetVersion++; _log.Clear(); _log.AddRange(InitialLog); }">
    <Preview>
        <Rows>
            <Panel @key="(_resetVersion, 0)" Title="Embedded scrollbar" Border="BoxBorder.Rounded" Height="7" Overflow="OverflowMode.Scroll" Focusable="true" Expand>
                @foreach (var item in AlphabetData)
                {
                    <Markup Content="@($"{item.Number,2}  {item.Letter}")" Foreground="@item.Color" />
                }
            </Panel>

            <Panel Title="Not embedded scrollbar - ScrollView with the bar outside" Border="BoxBorder.Rounded" Expand>
                <ScrollView @key="(_resetVersion, 1)" Height="4" Focusable="true" Scrollbar="@(new ScrollbarSettings(placement: ScrollbarPlacement.Outside))">
                    @foreach (var item in AlphabetData)
                    {
                        <Markup Content="@($"{item.Letter} - {item.Color}")" Foreground="@item.Color" />
                    }
                </ScrollView>
            </Panel>

            <Panel Title="Controller and StickToBottom" Border="BoxBorder.Rounded" Expand>
                <ScrollView Height="3" Controller="@_controller" StickToBottom="true">
                    @foreach (var line in _log)
                    {
                        <Markup Content="@line" />
                    }
                </ScrollView>
                <Columns>
                    <TextButton Content="Top" OnClick="@(() => _controller.ScrollToStartAsync())" />
                    <TextButton Content="Bottom" OnClick="@(() => _controller.ScrollToEndAsync())" />
                    <TextButton Content="Add line" OnClick="AddLine" />
                </Columns>
            </Panel>

            <Panel Title="Panel with a long text" Border="BoxBorder.Rounded" Height="5" Overflow="OverflowMode.Scroll" Scrollbar="@(new ScrollbarSettings())">
                <Markup Content="@_largeText" />
            </Panel>
        </Rows>
    </Preview>
</GalleryWorkbench>

@code {
    private int _resetVersion;
    private readonly ScrollController _controller = new();
    private static readonly string[] InitialLog = ["log: started", "log: connected", "log: ready"];
    private readonly List<string> _log = [.. InitialLog];

    private void AddLine() => _log.Add($"log: line {_log.Count + 1}");

    private readonly string _largeText = string.Join("\n", [
        "Start of line",
        "Some text",
        "Another text",
        "Loren ipsum",
        "Dolor sit amet",
        "Consectetur adipiscing elit",
        "Mauris sed congue dolor",
        "Nunc nisl metus, mollis eu condimentum in",
        "Accumsan sit amet nibh",
        "Aenean eleifend a ipsum eget hendrerit",
        "Nam gravida nulla tortor, sed rhoncus arcu aliquet sed",
        "End of line"
    ]);

    private IReadOnlyList<(int Number, string Letter, Color Color)> AlphabetData => GetAlphabetData();

    private IReadOnlyList<(int Number, string Letter, Color Color)> GetAlphabetData()
    {
        return
        [
            (1, "A", Color.Yellow),
            (2, "B", Color.Red),
            (3, "C", Color.Aqua),
            (4, "D", Color.Orange1),
            (5, "E", Color.Chartreuse1),
            (6, "F", Color.Magenta1),
            (7, "G", Color.Green3),
            (8, "H", Color.Blue),
            (9, "I", Color.Purple),
            (10, "J", Color.Gold1),
            (11, "K", Color.Turquoise2),
            (12, "L", Color.HotPink),
            (13, "M", Color.Lime),
            (14, "N", Color.LightCoral),
            (15, "O", Color.SkyBlue1)
        ];
    }

    private readonly string _scrollableMarkup = @"
<Panel Title=""Embedded scrollbar"" Border=""BoxBorder.Rounded"" Height=""7"" Overflow=""OverflowMode.Scroll"" Focusable=""true"" Expand>
    @foreach (var item in AlphabetData)
    {
        <Markup Content=""@($""{item.Number,2}  {item.Letter}"")"" Foreground=""@item.Color"" />
    }
</Panel>

<Panel Title=""Not embedded scrollbar - ScrollView with the bar outside"" Border=""BoxBorder.Rounded"" Expand>
    <ScrollView Height=""4"" Focusable=""true"" Scrollbar=""@(new ScrollbarSettings(placement: ScrollbarPlacement.Outside))"">
        @foreach (var item in AlphabetData)
        {
            <Markup Content=""@($""{item.Letter} - {item.Color}"")"" Foreground=""@item.Color"" />
        }
    </ScrollView>
</Panel>

<Panel Title=""Controller and StickToBottom"" Border=""BoxBorder.Rounded"" Expand>
    <ScrollView Height=""3"" Controller=""@_controller"" StickToBottom=""true"">
        @foreach (var line in _log)
        {
            <Markup Content=""@line"" />
        }
    </ScrollView>
    <Columns>
        <TextButton Content=""Top"" OnClick=""@(() => _controller.ScrollToStartAsync())"" />
        <TextButton Content=""Bottom"" OnClick=""@(() => _controller.ScrollToEndAsync())"" />
        <TextButton Content=""Add line"" OnClick=""AddLine"" />
    </Columns>
</Panel>

<Panel Title=""Panel with a long text"" Border=""BoxBorder.Rounded"" Height=""5"" Overflow=""OverflowMode.Scroll"" Scrollbar=""@(new ScrollbarSettings())"">
    <Markup Content=""@_largeText"" />
</Panel>
";

}
