@page "/zindex"
@implements IDisposable

<GalleryWorkbench Id="zindex" Title="Z-Index" Description="Move overlapping layers, swap their order and open a real modal." Code="@SampleCode" OnReset="Reset">
    <Preview>
        <Flex Width="44" Height="14" position="relative">
            <div position="absolute" top="@_top" left="@_left" z-index="@_firstZ">
                <Panel Width="24" Height="5" Title="Layer A" BorderColor="Color.Red">
                    <Markup Content="@($"Movable · z={_firstZ}")" />
                </Panel>
            </div>
            <div position="absolute" top="3" left="12" z-index="@_secondZ">
                <Panel Width="26" Height="5" Title="Layer B" BorderColor="Color.Green">
                    <Markup Content="@($"Overlap · z={_secondZ}")" />
                </Panel>
            </div>
            <div position="absolute" top="9" left="0" z-index="1">
                <Panel Width="40" Height="5" Title="Layer C" BorderColor="Color.DeepSkyBlue1">
                    <Markup Content="Nested positioning" />
                    <div position="absolute" top="1" left="19" z-index="2">
                        <Panel Width="18" Title="Layer E"><Markup Content="Relative to C" /></Panel>
                    </div>
                </Panel>
            </div>
        </Flex>
        <Markup Content="@($"Last action: {_lastAction}")" Foreground="Color.Grey58" />
        @if (_notification)
        {
            <Markup Content="Notification received" Foreground="Color.Chartreuse1" />
        }
        <ModalWindow IsOpened="@_modal">
            <Panel Title="Centered modal" BorderColor="Color.DeepSkyBlue1">
                <Rows>
                    <Markup Content="Above the other layers" />
                    <GalleryButton Id="zindex-close" Text="Close modal" OnClick="() => _modal = false" />
                </Rows>
            </Panel>
        </ModalWindow>
    </Preview>
    <Properties>
        <Flex Direction="FlexDirection.Row" Gap="1">
            <GalleryButton Id="zindex-move" Text="Move layer" OnClick="Move" />
            <GalleryButton Id="zindex-swap" Text="Swap order" OnClick="Swap" />
        </Flex>
        <Flex Direction="FlexDirection.Row" Gap="1">
            <GalleryButton Id="zindex-modal" Text="Open modal" OnClick="() => _modal = true" />
            <GalleryButton Id="zindex-notify" Text="Notify" OnClick="Notify" />
        </Flex>
    </Properties>
</GalleryWorkbench>

@code {
    private int _top = 1;
    private int _left = 1;
    private int _firstZ = 10;
    private int _secondZ = 20;
    private bool _modal;
    private bool _notification;
    private string _lastAction = "None";
    private readonly CancellationTokenSource _shutdown = new();
    private int _notificationVersion;
    private void Move() { _left = (_left + 2) % 12; _top = (_top + 1) % 4; _lastAction = $"Moved to {_left}, {_top}"; }
    private void Swap() { (_firstZ, _secondZ) = (_secondZ, _firstZ); _lastAction = "Order swapped"; }
    private void Reset() { _top = 1; _left = 1; _firstZ = 10; _secondZ = 20; _modal = false; _notification = false; _notificationVersion++; _lastAction = "None"; }
    private void Notify()
    {
        _notification = true;
        _lastAction = "Notification sent";
        _ = DismissNotificationAsync(++_notificationVersion);
    }
    private async Task DismissNotificationAsync(int version)
    {
        try
        {
            await Task.Delay(2000, _shutdown.Token);
            await InvokeAsync(() => { if (version == _notificationVersion) _notification = false; StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }
    public void Dispose() { _shutdown.Cancel(); _shutdown.Dispose(); }
    private string SampleCode => $@"
        <Flex Width=""44"" Height=""14"" position=""relative"">
            <div position=""absolute"" top=""{_top}"" left=""{_left}"" z-index=""{_firstZ}"">
                <Panel Width=""24"" Height=""5"" Title=""Layer A"" BorderColor=""Color.Red"">
                    <Markup Content=""Movable · z={_firstZ}"" />
                </Panel>
            </div>
            <div position=""absolute"" top=""3"" left=""12"" z-index=""{_secondZ}"">
                <Panel Width=""26"" Height=""5"" Title=""Layer B"" BorderColor=""Color.Green"">
                    <Markup Content=""Overlap · z={_secondZ}"" />
                </Panel>
            </div>
            <div position=""absolute"" top=""9"" left=""0"" z-index=""1"">
                <Panel Width=""40"" Height=""5"" Title=""Layer C"" BorderColor=""Color.DeepSkyBlue1"">
                    <Markup Content=""Nested positioning"" />
                    <div position=""absolute"" top=""1"" left=""19"" z-index=""2"">
                        <Panel Width=""18"" Title=""Layer E""><Markup Content=""Relative to C"" /></Panel>
                    </div>
                </Panel>
            </div>
        </Flex>
        <ModalWindow IsOpened=""@_modal"">
            <Panel Title=""Centered modal"" BorderColor=""Color.DeepSkyBlue1"">
                <Rows>
                    <Markup Content=""Above the other layers"" />
                    <GalleryButton Id=""zindex-close"" Text=""Close modal"" OnClick=""() => _modal = false"" />
                </Rows>
            </Panel>
        </ModalWindow>
".Trim();
}
