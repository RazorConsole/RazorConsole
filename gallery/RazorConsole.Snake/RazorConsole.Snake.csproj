<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>RazorConsole.Snake</AssemblyName>
    <PackageId>RazorConsole.Snake</PackageId>
    <Title>RazorConsole Snake</Title>
    <Description>A responsive terminal Snake game built with RazorConsole.</Description>
    <PackageProjectUrl>https://github.com/RazorConsole/RazorConsole/tree/main/gallery/RazorConsole.Snake</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RazorConsole/RazorConsole</RepositoryUrl>
    <Authors>RazorConsole</Authors>
    <ToolCommandName>razorconsole-snake</ToolCommandName>
    <RazorConsolePublishNativeAot>true</RazorConsolePublishNativeAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RazorConsole.Core\RazorConsole.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

</Project>
