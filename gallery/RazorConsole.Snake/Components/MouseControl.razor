@namespace RazorConsole.Snake.Components

<Flex Width="@Width"
      Height="1"
      Justify="FlexJustify.Center"
      data-focusable="false"
      @onclick="OnClick"
      @onmouseenter="() => SetHovered(true)"
      @onmouseleave="() => SetHovered(false)">
    <Markup Content="@Label"
            Foreground="@(_hovered ? Color.Black : Foreground)"
            Background="@(_hovered ? HoverBackground : Color.Default)"
            Decoration="Decoration.Bold" />
</Flex>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public int Width { get; set; } = 7;

    [Parameter]
    public Color Foreground { get; set; } = Color.Grey70;

    [Parameter]
    public Color HoverBackground { get; set; } = Color.DeepSkyBlue1;

    [Parameter]
    public EventCallback OnClick { get; set; }

    private bool _hovered;

    private void SetHovered(bool value)
    {
        _hovered = value;
    }
}
