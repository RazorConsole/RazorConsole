@namespace RazorConsole.Snake.Components
@implements IDisposable
@inject IHostApplicationLifetime Lifetime
@inject RazorConsole.Core.Rendering.ITerminalViewport Viewport

<Align Width="@SurfaceWidth"
       Height="@Viewport.Height"
       Horizontal="HorizontalAlignment.Center"
       Vertical="VerticalAlignment.Middle">
    @if (IsTerminalTooSmall)
    {
        <Rows Width="@SurfaceWidth">
            <Markup Content="TERMINAL TOO SMALL" Foreground="FoodColor" Decoration="Decoration.Bold" />
            <Markup Content="@($"Current: {Viewport.Width}x{Viewport.Height} · Required: 80x24 or larger")" />
            <Markup Content="Resize the terminal to launch the game grid." Foreground="Color.Grey70" />
            <Markup Content="Learn more → razorconsole.com"
                    Foreground="BrandBlue"
                    link="https://razorconsole.com/" />
        </Rows>
    }
    else
    {
        <Flex Direction="FlexDirection.Column"
              Width="@ContentWidth"
              Height="@ContentHeight"
              Gap="1"
              data-focusable="true"
              data-focus-key="razor-snake-game"
              data-focus-order="0"
              data-input-managed="true"
              @onkeydown="HandleKey">
            <Columns>
                <SpectreCanvas Pixels="BoardPixels"
                               CanvasWidth="@_game.Width"
                               CanvasHeight="@_game.Height"
                               PixelWidth="2"
                               Scale="false" />

                <Panel Title="RAZORCONSOLE SNAKE"
                       TitleColor="BrandBlue"
                       Border="BoxBorder.Rounded"
                       BorderColor="Color.Grey35"
                       Padding="new Padding(1, 0, 1, 0)"
                       Width="@SideWidth"
                       Height="@MainHeight">
                    <Align Width="25"
                           Height="@ControlHeight"
                           Horizontal="HorizontalAlignment.Center"
                           Vertical="VerticalAlignment.Middle">
                        <Rows>
                            <Markup Content="@ScoreAndLevelText" Foreground="BrandGreen" Decoration="Decoration.Bold" />
                            <Markup Content="@LengthAndSpeedText" Foreground="Color.Grey70" />
                            <Markup Content="@PhaseText" Foreground="PhaseColor" Decoration="Decoration.Bold" />
                            <SpeedControl Value="@_game.BaseTickDelayMilliseconds" ValueChanged="SetSpeed" />
                            <Flex Width="25" Justify="FlexJustify.Center">
                                <MouseControl Label="▲ UP" OnClick="@(() => Steer(Direction.Up))" />
                            </Flex>
                            <Flex Width="25" Justify="FlexJustify.Center" Gap="1">
                                <MouseControl Label="◀ LEFT" OnClick="@(() => Steer(Direction.Left))" />
                                <MouseControl Label="● PAUSE" OnClick="TogglePause" />
                                <MouseControl Label="RIGHT ▶" OnClick="@(() => Steer(Direction.Right))" />
                            </Flex>
                            <Flex Width="25" Justify="FlexJustify.Center">
                                <MouseControl Label="▼ DOWN" OnClick="@(() => Steer(Direction.Down))" />
                            </Flex>
                            <Flex Width="25" Justify="FlexJustify.Center" Gap="1">
                                <MouseControl Label="REBOOT" Width="10" Foreground="BrandBlue" OnClick="Restart" />
                                <MouseControl Label="QUIT" Width="10" Foreground="FoodColor" HoverBackground="FoodColor" OnClick="Quit" />
                            </Flex>
                            <Markup Content="MOUSE + ARROWS / WASD" Foreground="Color.Grey70" />
                        </Rows>
                    </Align>
                </Panel>
            </Columns>

            <Rows>
                <Markup Content="@PromptText" Foreground="PromptColor" Decoration="Decoration.Bold" />
                <Markup Content="Learn more → razorconsole.com"
                        Foreground="BrandBlue"
                        link="https://razorconsole.com/" />
            </Rows>
        </Flex>
    }
</Align>

@code {
    private const int MinimumTerminalWidth = 80;
    private const int MinimumTerminalHeight = 24;
    private const int SideWidth = 29;
    private static readonly Color BrandBlue = new(74, 144, 226);
    private static readonly Color BrandGreen = new(102, 255, 153);
    private static readonly Color BoardBackground = new(37, 52, 73);
    private static readonly Color SnakeBody = new(38, 194, 129);
    private static readonly Color SnakeHead = new(143, 255, 182);
    private static readonly Color FoodColor = new(255, 92, 92);
    private readonly CancellationTokenSource _shutdown = new();
    private SnakeEngine _game = null!;
    private (int x, int y, Color color)[] _boardPixels = [];

    private int SurfaceWidth => Math.Max(1, Viewport.Width - 1);
    private int MainHeight => DesiredBoardHeight;
    private int ControlHeight => Math.Max(1, MainHeight - 2);
    private int ContentWidth => (_game.Width * 2) + SideWidth + 1;
    private int ContentHeight => MainHeight + 3;
    private int DesiredBoardWidth => Math.Max(24, (SurfaceWidth - SideWidth - 1) / 2);
    private int DesiredBoardHeight => Math.Max(21, Viewport.Height - 3);
    private bool IsTerminalTooSmall => Viewport.Width < MinimumTerminalWidth || Viewport.Height < MinimumTerminalHeight;
    private (int x, int y, Color color)[] BoardPixels => _boardPixels;
    private string ScoreAndLevelText => $"SCORE {_game.Score:0000}  ·  LV {_game.Level:00}";
    private string LengthAndSpeedText => $"LEN {_game.Snake.Count:00}  ·  {_game.TickDelayMilliseconds} ms";
    private string PhaseText => $"STATUS: {_game.Phase.ToString().ToUpperInvariant()}";
    private Color PhaseColor => _game.Phase switch
    {
        GamePhase.Running => BrandGreen,
        GamePhase.Paused => Color.Yellow,
        GamePhase.GameOver => FoodColor,
        GamePhase.Won => BrandBlue,
        _ => Color.Grey70,
    };

    private string PromptText => _game.Phase switch
    {
        GamePhase.Ready => "READY // USE KEYBOARD OR CLICK A DIRECTION TO LAUNCH",
        GamePhase.Paused => "PAUSED // CLICK PAUSE OR PRESS SPACE TO RESUME",
        GamePhase.GameOver => "SIGNAL LOST // REBOOT TO RUN AGAIN",
        GamePhase.Won => "GRID OWNED // REBOOT TO RUN AGAIN",
        _ => "LIVE // COLLECT THE RED CORES · DO NOT CROSS THE SIGNAL",
    };

    private Color PromptColor => _game.Phase is GamePhase.GameOver ? FoodColor : BrandGreen;

    protected override void OnInitialized()
    {
        _game = new SnakeEngine(DesiredBoardWidth, DesiredBoardHeight);
        RebuildBoard();
        Viewport.OnResized += HandleViewportResize;
        _ = RunGameLoopAsync(_shutdown.Token);
    }

    private async Task RunGameLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(_game.TickDelayMilliseconds, cancellationToken);
                await InvokeAsync(() =>
                {
                    if (_game.Phase != GamePhase.Running)
                    {
                        return;
                    }

                    _game.Advance();
                    RebuildBoard();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void HandleKey(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "ArrowUp":
            case "w":
            case "W":
                Steer(Direction.Up);
                break;
            case "ArrowRight":
            case "d":
            case "D":
                Steer(Direction.Right);
                break;
            case "ArrowDown":
            case "s":
            case "S":
                Steer(Direction.Down);
                break;
            case "ArrowLeft":
            case "a":
            case "A":
                Steer(Direction.Left);
                break;
            case " ":
            case "Spacebar":
                TogglePause();
                break;
            case "r":
            case "R":
                Restart();
                break;
            case "+":
            case "=":
                SetSpeed(_game.BaseTickDelayMilliseconds - 1);
                break;
            case "-":
            case "_":
                SetSpeed(_game.BaseTickDelayMilliseconds + 1);
                break;
            case "q":
            case "Q":
            case "Escape":
                Quit();
                break;
        }
    }

    private void Steer(Direction direction)
    {
        _game.QueueDirection(direction);
        RebuildBoard();
    }

    private void TogglePause()
    {
        _game.TogglePause();
        RebuildBoard();
    }

    private void Restart()
    {
        _game.Restart();
        RebuildBoard();
    }

    private void SetSpeed(int milliseconds)
    {
        _game.SetSpeedDelay(milliseconds);
    }

    private void Quit()
    {
        Lifetime.StopApplication();
    }

    private void HandleViewportResize()
    {
        _ = InvokeAsync(() =>
        {
            if (!IsTerminalTooSmall)
            {
                _game.Resize(DesiredBoardWidth, DesiredBoardHeight);
                RebuildBoard();
            }

            StateHasChanged();
        });
    }

    private void RebuildBoard()
    {
        var pixels = new (int x, int y, Color color)[_game.Width * _game.Height];
        for (var y = 0; y < _game.Height; y++)
        {
            for (var x = 0; x < _game.Width; x++)
            {
                pixels[(y * _game.Width) + x] = (x, y, BoardBackground);
            }
        }

        var food = _game.Food;
        pixels[(food.Y * _game.Width) + food.X] = (food.X, food.Y, FoodColor);

        for (var index = _game.Snake.Count - 1; index >= 0; index--)
        {
            var segment = _game.Snake[index];
            pixels[(segment.Y * _game.Width) + segment.X] =
                (segment.X, segment.Y, index == 0 ? SnakeHead : SnakeBody);
        }

        _boardPixels = pixels;
    }

    public void Dispose()
    {
        Viewport.OnResized -= HandleViewportResize;
        _shutdown.Cancel();
        _shutdown.Dispose();
    }
}
