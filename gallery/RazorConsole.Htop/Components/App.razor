@namespace RazorConsole.Htop.Components
@implements IDisposable
@inject IHostApplicationLifetime Lifetime
@inject RazorConsole.Core.Rendering.ITerminalViewport Viewport

<Flex Direction="FlexDirection.Column"
      Width="@SurfaceWidth"
      Height="@Math.Max(8, Viewport.Height - 1)"
      data-focusable="true"
      data-focus-key="razor-htop"
      data-focus-order="0"
      data-input-managed="true"
      @onkeydown="HandleKey"
      @onwheel="HandleWheel">
    <Meter Label="CPU " Percent="@_snapshot.TotalCpuPercent" Value="@($"{_snapshot.TotalCpuPercent,5:0.0}%")" BarWidth="@BarWidth" />
    <Meter Label="Mem " Percent="@MemoryPercent" Value="@($"{FormatBytes(_snapshot.UsedMemoryBytes)}/{FormatBytes(_snapshot.TotalMemoryBytes)}")" BarWidth="@BarWidth" />
    <Markup Content="@InfoLine" Foreground="Color.Grey70" />

    <Flex Direction="FlexDirection.Row" Height="1">
        <ClickableLabel Label="@HeaderLabel(SortColumn.Pid, "PID", PidWidth, true)" Width="PidWidth" OnClick="@(() => SortBy(SortColumn.Pid))" />
        <ClickableLabel Label="@HeaderLabel(SortColumn.Name, "Name", NameWidth - 1, false)" Width="@(NameWidth - 1)" OnClick="@(() => SortBy(SortColumn.Name))" />
        <Flex Width="1" Height="1" data-focusable="false"
              @onmousedown="BeginResize" @onmousemove="DragResize" @onmouseup="EndResize"
              @onmouseenter="() => _handleHot = true" @onmouseleave="() => _handleHot = false">
            <Markup Content="┃" Foreground="@(_handleHot || _resizing ? Color.Yellow : Color.Black)" Background="Color.Green" />
        </Flex>
        <ClickableLabel Label="@HeaderLabel(SortColumn.Cpu, "CPU%", CpuWidth, true)" Width="CpuWidth" OnClick="@(() => SortBy(SortColumn.Cpu))" />
        <ClickableLabel Label="@HeaderLabel(SortColumn.Memory, "MEM", MemWidth, true)" Width="MemWidth" OnClick="@(() => SortBy(SortColumn.Memory))" />
        <ClickableLabel Label="@HeaderLabel(SortColumn.Threads, "THR", ThrWidth, true)" Width="ThrWidth" OnClick="@(() => SortBy(SortColumn.Threads))" />
        <ClickableLabel Label="@HeaderLabel(SortColumn.Time, "TIME+", TimeWidth, true)" Width="TimeWidth" OnClick="@(() => SortBy(SortColumn.Time))" />
    </Flex>

    <Flex Direction="FlexDirection.Row" Height="@PageSize">
        <Flex Direction="FlexDirection.Column" Width="@ListWidth" Height="@PageSize">
            @foreach (var row in VisibleRows)
            {
                <ProcessRow
                            Text="@FormatRow(row).PadRight(ListWidth - (row.Key == _selectedKey && row.Detail is null ? 6 : 0))"
                            Selected="@(row.Key == _selectedKey)"
                            Foreground="@(row.Detail is not null ? Color.Grey58 : row.IsGroup ? Color.Aqua : Color.Grey85)"
                            OnClick="@(() => Activate(row))"
                            OnKill="@(() => KillRow(row))" ShowKill="@(row.Detail is null)" />
            }
        </Flex>
        <Flex Direction="FlexDirection.Column" Width="1" Height="@PageSize">
            @for (var cell = 0; cell < PageSize; cell++)
            {
                var index = cell;
                var onThumb = IsThumb(index);
                <Flex Width="1" Height="1" data-focusable="false"
                      @onmousedown="@((MouseEventArgs e) => BeginScrollbar(index, e))"
                      @onmousemove="DragScrollbar" @onmouseup="EndScrollbar">
                    <Markup Content="@(onThumb ? "┃" : "│")" Foreground="@(onThumb ? (_scrollDragging ? Color.Yellow : Color.DeepSkyBlue1) : Color.Grey50)" />
                </Flex>
            }
        </Flex>
    </Flex>

    @if (_pendingKill is { } pending)
    {
        <Flex Direction="FlexDirection.Row" Height="1" Gap="1">
            <Markup Content="@KillPrompt(pending)" Foreground="Color.Yellow" Decoration="Decoration.Bold" />
            <ClickableLabel Label=" Yes (y) " Width="9" Background="Color.Red" OnClick="ConfirmKill" />
            <ClickableLabel Label=" No (n) " Width="8" Background="Color.Grey70" OnClick="CancelKill" />
        </Flex>
    }
    else
    {
        <Markup Content="@StatusLine" Foreground="@(_filterMode ? Color.Yellow : Color.Grey70)" />
    }

    <Flex Direction="FlexDirection.Row" Height="1" Gap="1">
        <ClickableLabel Label=" / Filter " Width="10" OnClick="StartFilter" />
        <ClickableLabel Label="@(_grouped ? " G Ungroup " : " G Group ")" Width="12" Background="@(_grouped ? Color.Aqua : Color.Green)" OnClick="ToggleGroup" />
        <ClickableLabel Label="@(AnyExpanded ? " E Collapse all " : " E Expand all ")" Width="@(AnyExpanded ? 16 : 14)" Background="Color.Purple" Foreground="Color.White" OnClick="ToggleAll" />
        <ClickableLabel Label=" F9 Kill " Width="9" OnClick="RequestKill" />
        <ClickableLabel Label="@(_paused ? " Space Resume " : " Space Pause ")" Width="14" OnClick="TogglePause" />
        <ClickableLabel Label=" Q Quit " Width="8" Background="Color.Grey70" OnClick="Quit" />
    </Flex>
</Flex>

@code {
    private const int PidWidth = 8;
    private const int MinNameWidth = 12;
    private const int MaxNameWidth = 80;
    private int _nameWidth = 40;
    private bool _nameAuto;
    private int FixedColumns => PidWidth + CpuWidth + MemWidth + ThrWidth + TimeWidth;
    private int NameWidth => Math.Max(MinNameWidth, Math.Min(_nameAuto ? int.MaxValue : _nameWidth, SurfaceWidth - 1 - FixedColumns));
    private int ListWidth => FixedColumns + NameWidth;
    private bool _resizing;
    private bool _handleHot;
    private int _resizeStartX;
    private int _resizeStartWidth;
    private const int CpuWidth = 8;
    private const int MemWidth = 11;
    private const int ThrWidth = 6;
    private const int TimeWidth = 12;
    private const int BarWidth = 30;
    private const int ChromeLines = 8;

    private readonly ProcessSampler _sampler = new();
    private readonly CancellationTokenSource _shutdown = new();
    private SystemSnapshot _snapshot = new([], 0, 0, 0, 0);
    private sealed record Row(string Key, ProcessEntry Entry, bool IsGroup, bool IsChild, IReadOnlyList<ProcessEntry> Members, string? Detail = null, string? OwnerKey = null);

    private readonly HashSet<int> _detailOpen = [];
    private readonly Dictionary<int, IReadOnlyList<string>> _details = [];

    private List<Row> _view = [];
    private readonly HashSet<string> _expanded = [];
    private bool _grouped;
    private SortColumn _sortColumn = SortColumn.Cpu;
    private bool _descending = true;
    private string? _selectedKey;
    private int _offset;
    private bool _paused;
    private bool _filterMode;
    private string _filter = string.Empty;
    private Row? _pendingKill;
    private string _message = string.Empty;
    private readonly DateTimeOffset _started = DateTimeOffset.Now;

    private int SurfaceWidth => Math.Max(40, Viewport.Width - 1);
    private int PageSize => Math.Max(3, Viewport.Height - ChromeLines);
    private double MemoryPercent => _snapshot.TotalMemoryBytes == 0 ? 0 : 100.0 * _snapshot.UsedMemoryBytes / _snapshot.TotalMemoryBytes;
    private IEnumerable<Row> VisibleRows => _view.Skip(_offset).Take(PageSize);

    private string InfoLine =>
        $"Tasks: {_snapshot.Processes.Count}, {_snapshot.ThreadCount} thr | Cores: {Environment.ProcessorCount} | {RuntimeInformation.OSDescription}{(_paused ? " | PAUSED" : string.Empty)}";

    private string StatusLine => _filterMode
        ? $"Filter: {_filter}_   (Enter/Esc to finish)"
        : !string.IsNullOrEmpty(_message) ? _message
        : _filter.Length > 0 ? $"Filter: \"{_filter}\" ({_view.Count} matches) | click a header to sort | wheel to scroll"
        : "Click a header to sort, a row to select, wheel to scroll | drag ┃ to resize Name | keys: ↑↓ ←→ / G E F9 C M P N T";

    protected override void OnInitialized()
    {
        Viewport.OnResized += HandleResize;
        Refresh();
        _ = RunAsync(_shutdown.Token);
    }

    private async Task RunAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(token).ConfigureAwait(false))
            {
                if (!_paused)
                {
                    await InvokeAsync(() =>
                    {
                        Refresh();
                        StateHasChanged();
                    }).ConfigureAwait(false);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void Refresh()
    {
        _snapshot = _sampler.Sample();
        ReloadDetails();
        Rebuild();
    }

    private void Rebuild()
    {
        IEnumerable<ProcessEntry> source = _snapshot.Processes;
        if (_filter.Length > 0)
        {
            source = source.Where(p => p.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || p.Id.ToString(CultureInfo.InvariantCulture).Contains(_filter, StringComparison.Ordinal));
        }

        _view = _grouped ? BuildGroups(source) : ProcessSorting.Sort(source, _sortColumn, _descending)
            .SelectMany(p => WithDetails(new Row(PidKey(p.Id), p, false, false, [p]))).ToList();
        if ((_selectedKey is null || _view.FindIndex(r => r.Key == _selectedKey) < 0) && _view.Count > 0)
        {
            _selectedKey = _view[0].Key;
        }

        ClampOffset();
    }

    private int SelectedIndex => _view.FindIndex(r => r.Key == _selectedKey);

    private static string PidKey(int pid) => "p:" + pid.ToString(CultureInfo.InvariantCulture);

    private List<Row> BuildGroups(IEnumerable<ProcessEntry> source)
    {
        var aggregates = source
            .GroupBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var members = g.ToList();
                var total = new ProcessEntry(
                    members.Min(m => m.Id), g.Key, members.Sum(m => m.Cpu), members.Sum(m => m.MemoryBytes),
                    members.Sum(m => m.Threads), TimeSpan.FromTicks(members.Sum(m => m.CpuTime.Ticks)));
                return (Total: total, Members: members);
            })
            .ToDictionary(x => x.Total.Name, StringComparer.OrdinalIgnoreCase);

        var rows = new List<Row>();
        foreach (var total in ProcessSorting.Sort(aggregates.Values.Select(x => x.Total), _sortColumn, _descending))
        {
            var members = aggregates[total.Name].Members;
            var groupKey = "g:" + total.Name;
            rows.AddRange(WithDetails(new Row(groupKey, total, true, false, members)));
            if (members.Count > 1 && _expanded.Contains(groupKey))
            {
                rows.AddRange(ProcessSorting.Sort(members, _sortColumn, _descending)
                    .SelectMany(m => WithDetails(new Row(PidKey(m.Id), m, false, true, [m]))));
            }
        }

        return rows;
    }

    private static bool IsProcessRow(Row row) => row.Detail is null && (!row.IsGroup || row.Members.Count == 1);

    private IEnumerable<Row> WithDetails(Row row)
    {
        yield return row;
        if (!IsProcessRow(row) || !_detailOpen.Contains(row.Members[0].Id))
        {
            yield break;
        }

        var pid = row.Members[0].Id;
        var lines = _details.TryGetValue(pid, out var cached) ? cached : [];
        var index = 0;
        var width = Math.Max(20, ListWidth - 14);
        for (var n = 0; n < lines.Count; n++)
        {
            var line = lines[n];
            var last = n == lines.Count - 1;
            for (var start = 0; start < line.Length || start == 0; start += width)
            {
                var chunk = line.Substring(start, Math.Min(width, line.Length - start));
                var prefix = start == 0 ? (last ? "└─ " : "├─ ") : (last ? "   " : "│  ");
                yield return new Row($"d:{pid}:{index++}", row.Entry, false, true, row.Members, prefix + chunk, row.Key);
            }
        }
    }

    private void ReloadDetails()
    {
        foreach (var stale in _details.Keys.Where(pid => !_detailOpen.Contains(pid)).ToList())
        {
            _details.Remove(stale);
        }

        foreach (var pid in _detailOpen)
        {
            _details[pid] = ProcessDetails.Load(pid);
        }
    }

    private void SetDetail(int pid, bool open)
    {
        if (open)
        {
            _detailOpen.Add(pid);
            _details[pid] = ProcessDetails.Load(pid);
        }
        else
        {
            _detailOpen.Remove(pid);
            _details.Remove(pid);
        }
    }

    private bool AnyExpanded => _expanded.Count > 0 || _detailOpen.Count > 0;

    private void ToggleAll()
    {
        if (AnyExpanded)
        {
            _expanded.Clear();
            _detailOpen.Clear();
            _details.Clear();
        }
        else if (_grouped)
        {
            foreach (var row in _view.Where(r => r.IsGroup && r.Members.Count > 1))
            {
                _expanded.Add(row.Key);
            }
        }
        else
        {
            // Expanding every process would sample hundreds of them each refresh, so only the visible page opens.
            foreach (var row in VisibleRows.Where(IsProcessRow))
            {
                SetDetail(row.Members[0].Id, true);
            }
        }

        Rebuild();
        EnsureSelectionVisible();
    }

    private void ToggleGroup()
    {
        _grouped = !_grouped;
        _selectedKey = null;
        _offset = 0;
        Rebuild();
    }

    private void Activate(Row row)
    {
        if (row.Detail is not null)
        {
            Select(row.OwnerKey!);
            return;
        }

        Select(row.Key);
        if (row.IsGroup && row.Members.Count > 1)
        {
            if (!_expanded.Remove(row.Key))
            {
                _expanded.Add(row.Key);
            }
        }
        else
        {
            var pid = row.Members[0].Id;
            SetDetail(pid, !_detailOpen.Contains(pid));
        }

        Rebuild();
    }

    private void ToggleSelectedGroup(bool expand)
    {
        var index = SelectedIndex;
        if (index < 0)
        {
            return;
        }

        var row = _view[index];
        if (row.Detail is not null)
        {
            if (!expand)
            {
                SetDetail(row.Members[0].Id, false);
                _selectedKey = row.OwnerKey;
                Rebuild();
            }

            return;
        }

        if (row.IsGroup && row.Members.Count > 1)
        {
            if (expand)
            {
                _expanded.Add(row.Key);
            }
            else
            {
                _expanded.Remove(row.Key);
            }
        }
        else
        {
            SetDetail(row.Members[0].Id, expand);
        }

        Rebuild();
    }

    private void ClampOffset() => _offset = Math.Clamp(_offset, 0, Math.Max(0, _view.Count - PageSize));

    private void EnsureSelectionVisible()
    {
        var index = SelectedIndex;
        if (index < 0)
        {
            return;
        }

        if (index < _offset)
        {
            _offset = index;
        }
        else if (index >= _offset + PageSize)
        {
            _offset = index - PageSize + 1;
        }

        ClampOffset();
    }

    private void Select(string key)
    {
        _selectedKey = key;
        _message = string.Empty;
    }

    private void Move(int delta)
    {
        if (_view.Count == 0)
        {
            return;
        }

        var index = SelectedIndex < 0 ? 0 : Math.Clamp(SelectedIndex + delta, 0, _view.Count - 1);
        var step = delta >= 0 ? 1 : -1;
        while (index >= 0 && index < _view.Count && _view[index].Detail is not null)
        {
            index += step;
        }

        if (index < 0 || index >= _view.Count)
        {
            index = Math.Clamp(index, 0, _view.Count - 1);
            while (index >= 0 && index < _view.Count && _view[index].Detail is not null)
            {
                index -= step;
            }

            if (index < 0 || index >= _view.Count)
            {
                return;
            }
        }

        _selectedKey = _view[index].Key;
        EnsureSelectionVisible();
    }

    private void SortBy(SortColumn column)
    {
        if (_sortColumn == column)
        {
            _descending = !_descending;
        }
        else
        {
            _sortColumn = column;
            _descending = column is not (SortColumn.Pid or SortColumn.Name);
        }

        Rebuild();
        EnsureSelectionVisible();
    }

    private void HandleWheel(WheelEventArgs e)
    {
        _offset += e.DeltaY > 0 ? 3 : -3;
        ClampOffset();
    }

    private void TogglePause() => _paused = !_paused;

    private void StartFilter()
    {
        _filterMode = true;
        _pendingKill = null;
    }

    private void RequestKill()
    {
        var index = SelectedIndex;
        if (index >= 0 && _view[index].Detail is null)
        {
            _pendingKill = _view[index];
        }
    }

    private static string KillPrompt(Row row) => row.IsGroup && row.Members.Count > 1
        ? $"Kill all {row.Members.Count} {row.Entry.Name} processes?"
        : $"Kill {row.Entry.Name} (PID {row.Members[0].Id})?";

    private void KillRow(Row row)
    {
        Select(row.Key);
        _pendingKill = row;
    }

    private void CancelKill() => _pendingKill = null;

    private void ConfirmKill()
    {
        if (_pendingKill is not { } target)
        {
            return;
        }

        _pendingKill = null;
        var killed = 0;
        string? error = null;
        foreach (var member in target.Members)
        {
            try
            {
                using var process = Process.GetProcessById(member.Id);
                process.Kill();
                killed++;
            }
            catch (Exception ex)
            {
                error = $"PID {member.Id}: {ex.Message}";
            }
        }

        _message = error is null ? $"Sent kill to {killed} process(es) of {target.Entry.Name}." : $"Killed {killed}; cannot kill {error}";

        Refresh();
    }

    private void Quit() => Lifetime.StopApplication();

    private void HandleKey(KeyboardEventArgs args)
    {
        if (_pendingKill is not null)
        {
            switch (args.Key)
            {
                case "y" or "Y" or "Enter": ConfirmKill(); break;
                default: CancelKill(); break;
            }

            return;
        }

        if (_filterMode)
        {
            HandleFilterKey(args);
            return;
        }

        _message = string.Empty;
        switch (args.Key)
        {
            case "ArrowUp" or "k": Move(-1); break;
            case "ArrowDown" or "j": Move(1); break;
            case "PageUp": Move(-PageSize); break;
            case "PageDown": Move(PageSize); break;
            case "Home": Move(-_view.Count); break;
            case "End": Move(_view.Count); break;
            case "F9" or "Delete": RequestKill(); break;
            case "/" or "F4": StartFilter(); break;
            case "g" or "G": ToggleGroup(); break;
            case "e" or "E": ToggleAll(); break;
            case "[": _nameWidth = Math.Max(MinNameWidth, NameWidth - 2); _nameAuto = false; break;
            case "]": _nameWidth = Math.Min(MaxNameWidth, NameWidth + 2); _nameAuto = false; break;
            case "ArrowRight" or "Enter": ToggleSelectedGroup(true); break;
            case "ArrowLeft": ToggleSelectedGroup(false); break;
            case " " or "Spacebar": TogglePause(); break;
            case "c" or "C": SortBy(SortColumn.Cpu); break;
            case "m" or "M": SortBy(SortColumn.Memory); break;
            case "p" or "P": SortBy(SortColumn.Pid); break;
            case "n" or "N": SortBy(SortColumn.Name); break;
            case "t" or "T": SortBy(SortColumn.Time); break;
            case "Escape" when _filter.Length > 0: _filter = string.Empty; Rebuild(); break;
            case "q" or "Q" or "Escape" or "F10": Quit(); break;
        }
    }

    private void HandleFilterKey(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Enter": _filterMode = false; break;
            case "Escape": _filterMode = false; _filter = string.Empty; break;
            case "Backspace" when _filter.Length > 0: _filter = _filter[..^1]; break;
            default:
                if (args.Key.Length == 1 && !char.IsControl(args.Key[0]))
                {
                    _filter += args.Key;
                }

                break;
        }

        _offset = 0;
        Rebuild();
    }

    private void HandleResize()
    {
        _ = InvokeAsync(() =>
        {
            ClampOffset();
            StateHasChanged();
        });
    }

    private int ThumbLength => Math.Max(1, PageSize * PageSize / Math.Max(PageSize, _view.Count));
    private int MaxOffset => Math.Max(0, _view.Count - PageSize);
    private int ThumbTop => MaxOffset == 0 ? 0 : (int)Math.Round((double)_offset * (PageSize - ThumbLength) / MaxOffset);
    private bool IsThumb(int cell) => MaxOffset > 0 && cell >= ThumbTop && cell < ThumbTop + ThumbLength;

    private bool _scrollDragging;
    private int _scrollStartY;
    private int _scrollStartOffset;

    private void BeginScrollbar(int cell, MouseEventArgs e)
    {
        if (MaxOffset == 0)
        {
            return;
        }

        if (IsThumb(cell))
        {
            _scrollDragging = true;
            _scrollStartY = (int)e.ClientY;
            _scrollStartOffset = _offset;
        }
        else
        {
            _offset += cell < ThumbTop ? -PageSize : PageSize;
            ClampOffset();
        }

        StateHasChanged();
    }

    private void DragScrollbar(MouseEventArgs e)
    {
        var travel = PageSize - ThumbLength;
        if (!_scrollDragging || travel <= 0)
        {
            return;
        }

        var offset = _scrollStartOffset + (int)Math.Round((e.ClientY - _scrollStartY) * MaxOffset / travel);
        offset = Math.Clamp(offset, 0, MaxOffset);
        if (offset != _offset)
        {
            _offset = offset;
            StateHasChanged();
        }
    }

    private void EndScrollbar(MouseEventArgs e)
    {
        _scrollDragging = false;
        StateHasChanged();
    }

    private void BeginResize(MouseEventArgs e)
    {
        _resizing = true;
        _resizeStartX = (int)e.ClientX;
        _resizeStartWidth = NameWidth;
    }

    private void DragResize(MouseEventArgs e)
    {
        if (!_resizing)
        {
            return;
        }

        var width = Math.Clamp(_resizeStartWidth + (int)e.ClientX - _resizeStartX, MinNameWidth, MaxNameWidth);
        if (width != NameWidth)
        {
            _nameAuto = false;
            _nameWidth = width;
            StateHasChanged();
        }
    }

    private void EndResize(MouseEventArgs e)
    {
        _resizing = false;
        StateHasChanged();
    }

    private string HeaderLabel(SortColumn column, string title, int width, bool right)
    {
        var text = _sortColumn == column ? title + (_descending ? "▼" : "▲") : title;
        return right ? text.PadLeft(width - 1) + " " : text.PadRight(width);
    }

    private string FormatRow(Row row)
    {
        if (row.Detail is { } detail)
        {
            var text = new string(' ', PidWidth + 1) + detail;
            var max = Math.Max(20, SurfaceWidth - 1);
            return text.Length > max ? text[..max] : text;
        }

        var p = row.Entry;
        var marker = _detailOpen.Contains(p.Id) ? "▾ " : "▸ ";
        var multi = row.IsGroup && row.Members.Count > 1;
        var label = multi ? $"{(_expanded.Contains(row.Key) ? "▾ " : "▸ ")}{p.Name} ({row.Members.Count})"
            : row.IsChild ? "  " + marker + p.Name
            : marker + p.Name;
        var name = label.Length > NameWidth - 1 ? label[..(NameWidth - 1)] : label;
        var time = p.CpuTime.TotalHours >= 1
            ? $"{(int)p.CpuTime.TotalHours}:{p.CpuTime.Minutes:00}:{p.CpuTime.Seconds:00}"
            : $"{p.CpuTime.Minutes}:{p.CpuTime.Seconds:00}.{p.CpuTime.Milliseconds / 10:00}";
        return string.Create(CultureInfo.InvariantCulture,
            $"{(multi ? "-" : p.Id.ToString(CultureInfo.InvariantCulture)),PidWidth - 1} {name.PadRight(NameWidth)}{p.Cpu,CpuWidth - 1:0.0} {FormatBytes(p.MemoryBytes),MemWidth - 1} {p.Threads,ThrWidth - 1} {time,TimeWidth - 1}");
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "K", "M", "G", "T"];
        double value = bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return string.Create(CultureInfo.InvariantCulture, $"{value:0.#}{units[unit]}");
    }

    public void Dispose()
    {
        Viewport.OnResized -= HandleResize;
        _shutdown.Cancel();
        _shutdown.Dispose();
    }
}





