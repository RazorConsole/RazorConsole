@namespace FpsBenchmark.Components
@implements IDisposable

@using System.Diagnostics
@using Microsoft.AspNetCore.Components
@using RazorConsole.Components
@using Spectre.Console

<Box Border="BoxBorder.Rounded" Padding="new (1)">
    <Rows>
        <Markup Content="@($"RazorConsole render benchmark - pipeline: WidgetLayout")" Foreground="@Color.Aqua" Decoration="@Decoration.Bold" />
        <Markup Content="@($"Drawn FPS (terminal writes): {_drawnFps:F1}")" Foreground="@Color.Green" Decoration="@Decoration.Bold" />
        <Markup Content="@($"Render FPS (pipeline): {_fps:F1}   avg frame: {(_fps > 0 ? 1000 / _fps : 0):F1} ms   frames: {_frames}")" Foreground="@Color.Green" Decoration="@Decoration.Bold" />
        <Markup Content="@($"Peak FPS: {_peak:F1}   avg since start: {_average:F1}")" Foreground="@Color.Yellow" />
        <Newline />
        @for (var i = 0; i < Counter.Rows; i++)
        {
            var row = i;
            <Markup Content="@($"Row {row:D2} {Bar(row)}")" Foreground="@(row % 2 == 0 ? Color.Grey70 : Color.Grey50)" />
        }
        <Newline />
        <Markup Content="Redraws as fast as possible - Press Ctrl+C to exit" Foreground="@Color.Grey58" />
    </Rows>
</Box>

@code {
    [Inject]
    private FrameCounter Counter { get; set; } = default!;

    private readonly CancellationTokenSource _cts = new();
    private int _tick;
    private long _frames;
    private double _fps;
    private double _peak;
    private double _average;
    private double _drawnFps;
    private long _lastWrites;
    private long _lastFrames;
    private long _lastTimestamp = Stopwatch.GetTimestamp();

    protected override void OnInitialized()
    {
        _ = RunAsync(_cts.Token);
    }

    private string Bar(int row)
    {
        var width = 40;
        var pos = (_tick + row * 3) % (width * 2);
        pos = pos < width ? pos : width * 2 - pos;
        return new string('#', pos).PadRight(width, '.');
    }

    private async Task RunAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                var now = Stopwatch.GetTimestamp();
                var elapsed = Stopwatch.GetElapsedTime(_lastTimestamp, now).TotalSeconds;
                if (elapsed >= 0.5)
                {
                    _frames = Counter.Frames;
                    _fps = (_frames - _lastFrames) / elapsed;
                    _peak = Math.Max(_peak, _fps);
                    _average = _frames / Stopwatch.GetElapsedTime(Counter.StartTimestamp, now).TotalSeconds;
                    var writes = Counter.Writes;
                    _drawnFps = (writes - _lastWrites) / elapsed;
                    _lastWrites = writes;
                    _lastFrames = _frames;
                    _lastTimestamp = now;
                }

                _tick++;
                await InvokeAsync(StateHasChanged);
                Counter.RecordFrame();
                await Task.Yield();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose() => _cts.Cancel();
}
